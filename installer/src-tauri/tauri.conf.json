{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Установщик карт КрайКарт",
  "version": "0.2.0",
  "identifier": "com.kraimaps.installer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Установщик карт КрайКарт",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "KraiMaps",
    "homepage": "https://kraimaps.ru",
    "copyright": "© 2026 KraiMaps",
    "category": "Game",
    "shortDescription": "Установщик карт Minecraft и других игр с сайта KraiMaps",
    "longDescription": "Установка карт Minecraft и других игр с сайта kraimaps.ru в любой современный лаунчер: vanilla-миры и сборки модов.",
    "licenseFile": "./nsis/license.txt",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "./nsis/installer.nsi",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Russian": "./nsis/Russian.nsh"
        },
        "headerImage": null,
        "sidebarImage": "./nsis/assets/sidebar.bmp",
        "uninstallerHeaderImage": null,
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kraimaps"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4QjMzMjhDNTQxNjkzNEEKUldSS2t4WlVqREt6dUNWcWN6aUJmT3FDRmt3ZDJjL0RUdUNIUHN3OXEvTG5hTDI2cjg3cExwaVQK",
      "endpoints": [
        "https://kraimaps.ru/api/v1/installer/updates?current={{current_version}}&target={{target}}&arch={{arch}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
