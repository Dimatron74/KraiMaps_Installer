# Tauri update signing: приватный ключ НИКОГДА не в git
# (утрата/утечка = поддельные обновления или смерть апдейтов).
# Публичный *.key.pub — можно и нужно коммитить, он для проверки.
# Бэкап приватного ключа + пароль CI — отдельно, вне репозитория.
installer/.keys/*.key

